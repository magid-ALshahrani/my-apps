# انسخ هذا الملف إلى .env (لا ترفع .env إلى Git) وضع قيمك الخاصة.
# لا تضع أي قيمة حقيقية في هذا الملف.

# رمز دخول المعلم (صلاحيات كاملة)
ADMIN_PIN=
# رمز دخول المدير (اطلاع فقط)
MANAGER_PIN=
# سر توقيع الجلسات: نص عشوائي طويل (32 حرفًا على الأقل)
SESSION_SECRET=
# الحد الأقصى لحجم الملف بالميجابايت (الافتراضي 20، ويمكن تغييره لاحقًا من الإعدادات)
MAX_FILE_MB=20
# مجلد البيانات الدائم (قاعدة البيانات + الملفات المرفوعة)
DATA_DIR=./data
# منفذ الخادم
PORT=3000
# بيئة التشغيل: production في النشر
NODE_ENV=production
# بيانات تجريبية وهمية (فصلان و6 طلاب) — اتركه 0 في الاستخدام الحقيقي
SEED_DEMO=0
